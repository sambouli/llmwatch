[Unit]
Description=llmwatch — tiny LLM monitoring stack (sparky engines + openbrouter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/s/llmwatch
ExecStart=/home/s/llmwatch/llmwatch -config /home/s/llmwatch/config.yaml
# The OpenBrouter admin key; keep the value in this file only (chmod 600).
EnvironmentFile=-/home/s/llmwatch/llmwatch.env
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
